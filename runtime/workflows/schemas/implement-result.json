{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "ticket ワークフローの implement（feature-implementer）の型付き出力。behaviors・residual_findings・unverified・cross_repo_attestation は pull-request 種類が PR 本文へそのまま転記する（I7・I13）",
  "type": "object",
  "required": ["outcome", "pr_title", "summary", "behaviors", "residual_findings", "unverified", "cross_repo_attestation", "deviation_report"],
  "properties": {
    "outcome": { "type": "string", "enum": ["pass", "skip", "failure", "deviation", "review_incomplete"] },
    "pr_title": { "type": "string" },
    "summary": { "type": "string" },
    "behaviors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "name", "guarantees"],
        "properties": {
          "kind": { "type": "string", "enum": ["test", "e2e", "signature"] },
          "name": { "type": "string" },
          "guarantees": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "residual_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["location", "severity", "claim", "reason"],
        "properties": {
          "location": { "type": "string" },
          "severity": { "type": "string" },
          "claim": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "unverified": { "type": "array", "items": { "type": "string" } },
    "cross_repo_attestation": { "type": "string" },
    "deviation_report": { "type": "string" }
  },
  "additionalProperties": false
}
