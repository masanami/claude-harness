{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "list-test-files.sh の stdout（plugin/scripts/specs/list-test-files.md）",
  "type": "object",
  "required": ["status", "root", "source", "counts", "files"],
  "properties": {
    "status": { "type": "string", "enum": ["ok", "no_test_files_found"] },
    "root": { "type": "string" },
    "source": { "type": "string", "enum": ["git", "find"] },
    "counts": {
      "type": "object",
      "required": ["e2e", "integration", "unit", "total", "skipped"],
      "properties": {
        "e2e": { "type": "integer" },
        "integration": { "type": "integer" },
        "unit": { "type": "integer" },
        "total": { "type": "integer" },
        "skipped": { "type": "integer" }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "category", "rule"],
        "properties": {
          "path": { "type": "string" },
          "category": { "type": "string", "enum": ["e2e", "integration", "unit"] },
          "rule": { "type": "string" }
        }
      }
    }
  }
}
