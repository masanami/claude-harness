{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "pull-request 種類の action: ensure-base の出力。runtime が生成する（docs/harness-runtime-design.md §5.6.3）。head_sha は created・existing のとき統合ブランチの先頭、それ以外は空文字",
  "type": "object",
  "required": ["outcome", "detail", "branch", "head_sha"],
  "properties": {
    "outcome": { "type": "string", "enum": ["created", "existing", "refused", "unavailable"] },
    "detail": { "type": "string" },
    "branch": { "type": "string" },
    "head_sha": { "type": "string" }
  },
  "additionalProperties": false
}
