{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "pull-request 種類の出力。runtime が生成する（docs/harness-runtime-design.md §3.2）",
  "type": "object",
  "required": ["outcome", "pr_number", "pr_url", "branch", "head_sha"],
  "properties": {
    "outcome": { "type": "string", "enum": ["opened", "updated"] },
    "pr_number": { "type": "integer", "minimum": 1 },
    "pr_url": { "type": "string" },
    "branch": { "type": "string" },
    "head_sha": { "type": "string" }
  },
  "additionalProperties": false
}
