{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "pull-request 種類の action: adopt の出力。runtime が生成する（docs/harness-runtime-design.md §5.6.2・§5.6.3）。扱えない PR・ブランチは outcome で返し、PR の欄は空（0・空文字）。no_pr は、統合ブランチの名前を受け、開いている PR が無いときで、branch・base・head_sha だけが入る。source は、受けた ref が PR の URL（pr）かブランチの名前（integration）か（受けられなかったときは pr）",
  "type": "object",
  "required": ["outcome", "detail", "pr_number", "pr_url", "branch", "base", "head_sha", "key", "source"],
  "properties": {
    "outcome": { "type": "string", "enum": ["adopted", "no_pr", "unsupported_ref", "branch_missing", "empty", "not_open", "not_default_base", "fork", "draft", "other_repo"] },
    "detail": { "type": "string" },
    "pr_number": { "type": "integer", "minimum": 0 },
    "pr_url": { "type": "string" },
    "branch": { "type": "string" },
    "base": { "type": "string" },
    "head_sha": { "type": "string" },
    "key": { "type": "string" },
    "source": { "type": "string", "enum": ["pr", "integration"] }
  },
  "additionalProperties": false
}
