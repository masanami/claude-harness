{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "pull-request 種類の action: adopt の出力。runtime が生成する（docs/harness-runtime-design.md §5.6.2）。扱えない PR は outcome で返し、PR の欄は空（0・空文字）",
  "type": "object",
  "required": ["outcome", "detail", "pr_number", "pr_url", "branch", "base", "head_sha", "key"],
  "properties": {
    "outcome": { "type": "string", "enum": ["adopted", "unsupported_ref", "not_open", "not_default_base", "fork", "draft", "other_repo"] },
    "detail": { "type": "string" },
    "pr_number": { "type": "integer", "minimum": 0 },
    "pr_url": { "type": "string" },
    "branch": { "type": "string" },
    "base": { "type": "string" },
    "head_sha": { "type": "string" },
    "key": { "type": "string" }
  },
  "additionalProperties": false
}
